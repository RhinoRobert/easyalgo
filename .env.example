# PNET LaunchLab (standalone). Copy to .env.local and fill in. Nothing here is a secret: every value is a public network identifier.
# The app never reads a mnemonic or private key: Pera Wallet signs every transaction group.

# localnet | testnet | mainnet   (default: testnet)
VITE_NETWORK=testnet

# --- required on every network: the deployed PNET Instant Launchpad v2 application ---------------------------------------------------
# Printed by `python -m launchpad_v2.deploy verify-record ...` after the platform authority account has created and initialized it.
VITE_LAUNCHPAD_V2_APP_ID=

# --- TestNet only (MainNet pins these in the app and in the contract bytecode) ----------------------------------------------------------
# A six-decimal test asset standing in for PNET, and the Tinyman v2 ALGO/PNET pool address that has liquidity.
VITE_LAUNCHPAD_V2_PNET_ID=
VITE_TINYMAN_SOURCE_POOL=

# --- MainNet only: the controlled-canary gate. Do not set until docs/MAINNET_ROLLOUT_CHECKLIST.md is signed off. ----------------------
# VITE_ENABLE_MAINNET_LAUNCHPAD=I_ACCEPT_CONTROLLED_MAINNET_CANARY

# --- optional ---------------------------------------------------------------------------------------------------------------------
# Show the wallet-signed deployment console (development builds only): needs the unsigned package from contracts/launchpad_v2/deploy.py.
# VITE_SHOW_DEPLOYMENT_CONSOLE=true
