// launchpad_v3.contract.PNETInstantLaunchpad.claim_creator_lp[routing]() -> void:
claim_creator_lp:
    // launchpad_v3/contract.py:581
    // @arc4.abimethod
    txn GroupIndex
    intc_1 // 1
    -
    dup
    gtxns TypeEnum
    pushint 4 // axfer
    ==
    assert // transaction type is axfer
    txna ApplicationArgs 1
    dup
    len
    intc_2 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    dup
    btoi
    // launchpad_v3/contract.py:584
    // assert lp_opt_in.group_index + UInt64(1) == Txn.group_index, "LP opt-in must precede call"
    dig 2
    gtxns GroupIndex
    intc_1 // 1
    +
    txn GroupIndex
    ==
    assert // LP opt-in must precede call
    // launchpad_v3/contract.py:585
    // assert Txn.rekey_to == algopy.Account(), "No app-call rekey"
    txn RekeyTo
    global ZeroAddress
    ==
    assert // No app-call rekey
    // launchpad_v3/contract.py:586
    // assert asset_id in self.launches, "Unknown launch"
    itob
    bytec 8 // 0x6c
    swap
    concat
    dup
    box_len
    bury 1
    assert // Unknown launch
    // launchpad_v3/contract.py:587-588
    // record = self.launches[asset_id].copy()
    // assert record.status.as_uint64() == UInt64(STATUS_COMPLETE), "Launch must be complete"
    dup
    pushint 48
    intc_2 // 8
    box_extract // on error: index out of bounds
    // launchpad_v3/contract.py:588
    // assert record.status.as_uint64() == UInt64(STATUS_COMPLETE), "Launch must be complete"
    btoi
    intc_3 // 2
    ==
    assert // Launch must be complete
    // launchpad_v3/contract.py:589
    // assert record.launcher.native == Txn.sender, "Only the launcher may claim"
    dup
    intc_0 // 0
    pushint 32
    box_extract // on error: index out of bounds
    txn Sender
    ==
    assert // Only the launcher may claim
    // launchpad_v3/contract.py:590
    // assert record.creator_lp_claimed.as_uint64() == UInt64(0), "Creator LP already claimed"
    dup
    pushint 144
    intc_2 // 8
    box_extract // on error: index out of bounds
    btoi
    !
    assert // Creator LP already claimed
    // launchpad_v3/contract.py:592
    // lp_id = record.pool_token_id.as_uint64()
    dup
    pushint 112
    intc_2 // 8
    box_extract // on error: index out of bounds
    btoi
    // launchpad_v3/contract.py:593
    // assert lp_opt_in.sender == Txn.sender, "LP opt-in sender mismatch"
    dig 3
    gtxns Sender
    txn Sender
    ==
    assert // LP opt-in sender mismatch
    // launchpad_v3/contract.py:594
    // assert lp_opt_in.asset_receiver == Txn.sender, "LP opt-in receiver mismatch"
    dig 3
    gtxns AssetReceiver
    txn Sender
    ==
    assert // LP opt-in receiver mismatch
    // launchpad_v3/contract.py:595
    // assert lp_opt_in.xfer_asset.id == lp_id, "Wrong LP asset"
    dig 3
    gtxns XferAsset
    dig 1
    ==
    assert // Wrong LP asset
    // launchpad_v3/contract.py:596
    // assert lp_opt_in.asset_amount == UInt64(0), "LP opt-in amount must be zero"
    dig 3
    gtxns AssetAmount
    !
    assert // LP opt-in amount must be zero
    // launchpad_v3/contract.py:597
    // assert lp_opt_in.asset_close_to == algopy.Account(), "No LP close"
    dig 3
    gtxns AssetCloseTo
    global ZeroAddress
    ==
    assert // No LP close
    // launchpad_v3/contract.py:598
    // assert lp_opt_in.asset_sender == algopy.Account(), "No clawback sender"
    dig 3
    gtxns AssetSender
    global ZeroAddress
    ==
    assert // No clawback sender
    // launchpad_v3/contract.py:599
    // assert lp_opt_in.rekey_to == algopy.Account(), "No LP opt-in rekey"
    uncover 3
    gtxns RekeyTo
    global ZeroAddress
    ==
    assert // No LP opt-in rekey
    // launchpad_v3/contract.py:601
    // amount = record.creator_lp.as_uint64()
    dig 1
    pushint 136
    intc_2 // 8
    box_extract // on error: index out of bounds
    dup
    btoi
    // launchpad_v3/contract.py:602-605
    // itxn.AssetTransfer(
    //     xfer_asset=lp_id, asset_receiver=Txn.sender, asset_amount=amount,
    //     fee=UInt64(0), note=b"PNET Launchpad v3 creator LP",
    // ).submit()
    itxn_begin
    // launchpad_v3/contract.py:603
    // xfer_asset=lp_id, asset_receiver=Txn.sender, asset_amount=amount,
    txn Sender
    // launchpad_v3/contract.py:604
    // fee=UInt64(0), note=b"PNET Launchpad v3 creator LP",
    pushbytes 0x504e4554204c61756e63687061642076332063726561746f72204c50
    itxn_field Note
