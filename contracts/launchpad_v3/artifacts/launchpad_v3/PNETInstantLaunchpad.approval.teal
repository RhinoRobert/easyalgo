    itxn_field AssetAmount
    swap
    itxn_field XferAsset
    // launchpad_v3/contract.py:602
    // itxn.AssetTransfer(
    pushint 4 // axfer
    itxn_field TypeEnum
    // launchpad_v3/contract.py:604
    // fee=UInt64(0), note=b"PNET Launchpad v3 creator LP",
    intc_0 // 0
    itxn_field Fee
    // launchpad_v3/contract.py:602-605
    // itxn.AssetTransfer(
    //     xfer_asset=lp_id, asset_receiver=Txn.sender, asset_amount=amount,
    //     fee=UInt64(0), note=b"PNET Launchpad v3 creator LP",
    // ).submit()
    itxn_submit
    // launchpad_v3/contract.py:606
    // record.creator_lp_claimed = arc4.UInt64(UInt64(1))
    intc_1 // 1
    itob
    // launchpad_v3/contract.py:606-607
    // record.creator_lp_claimed = arc4.UInt64(UInt64(1))
    // self.launches[asset_id] = record.copy()
    uncover 2
    pushint 144
    uncover 2
    box_replace // on error: index out of bounds
    // launchpad_v3/contract.py:608
    // arc4.emit(CreatorLpClaimed(arc4.Address(Txn.sender), arc4.UInt64(asset_id), arc4.UInt64(amount)))
    txn Sender
    uncover 2
    concat
    swap
    concat
    pushbytes 0xe2cde2c0 // method "CreatorLpClaimed(address,uint64,uint64)"
    swap
    concat
    log
    // launchpad_v3/contract.py:581
    // @arc4.abimethod
    intc_1 // 1
    return


